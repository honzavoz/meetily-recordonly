{
  "manifest_version": 3,
  "name": "Record Only - Meet Reminder",
  "description": "Reminds you to start a local Record Only recording when a Google Meet call begins.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Record Only - Meet Reminder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
